rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
    }

    match /popular_searches/{searchId} {
      allow read: if true;
    }

    match /product_keys/{productId} {
      allow read, write: if false;
    }
  }
}
