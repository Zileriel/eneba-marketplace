{
  "name": "eneba-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "node --env-file-if-exists=.env.local node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "migrate:product-keys": "node --env-file=.env.local scripts/migrate-product-keys.mjs",
    "seed:popular-searches": "node --env-file=.env.local scripts/seed-popular-searches.mjs",
    "seed:products": "node --env-file=.env.local scripts/seed-products.mjs"
  },
  "dependencies": {
    "@react-router/express": "8.3.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@typehaus/metropolis": "^12.0.0-next.7",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "isbot": "^5.1.36",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router": "8.3.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
